# =============================================================
# Trading Barang ERP — Environment Variables Template
# =============================================================
# INSTRUKSI: Salin file ini menjadi .env dan isi nilainya.
#   cp .env.example .env
# File .env TIDAK boleh di-commit ke Git.
# =============================================================

# --- PostgreSQL Database ---
DB_HOST=db
DB_USER=postgres
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_DAN_ACAK
DB_NAME=erp_pkp
# Port internal Docker network database
DB_PORT=5432
# Gunakan "require" jika database ada di server terpisah dengan SSL
DB_SSLMODE=disable

# --- Backend (Go/Gin) ---
# Hasilkan dengan: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER

# Mode: "release" untuk production, "debug" untuk development
GIN_MODE=release

# Set ke "true" HANYA saat pertama kali setup untuk mengisi data awal.
# Setelah data ada, set ke "false" atau hapus variabel ini.
AUTO_SEED=false

# --- Frontend (Vue/Vite) ---
# URL backend yang diakses dari BROWSER user:
# - Di VPS dengan Single Domain Reverse Proxy: https://erp.yourdomain.com
# - Di VPS dengan Split Subdomain: https://api-erp.yourdomain.com
# - Di Local Testing: http://localhost:8083
VITE_API_BASE_URL=http://localhost:8083

# --- CORS ---
# Origin yang diizinkan untuk mengakses backend API:
# - Di VPS: https://erp.yourdomain.com
# - Di Local Testing: http://localhost:3003
ALLOWED_ORIGIN=http://localhost:3003
